# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# setup-openshift.sh reads this file and only prompts for anything left blank;
# it also (re)writes it after a successful run. `source .env.local` for the
# local helper scripts (lightwell-report.sh, fetch-lightwell-app-jars.sh).

# 1. Red Hat CONSOLE service account — pulls the Lightwell remediated jars.
#    Username form: orgID|service-account-name   (get it at https://console.redhat.com -> Service Accounts)
export RHLN_USER=''
export RHLN_TOKEN=''

# 2. Red Hat REGISTRY service account — pulls the RHTAS cosign image (only needed
#    for the signing add-on). Username form: NNNNNNN|name  (DIFFERENT from #1;
#    get it at https://registry.redhat.io -> Service Accounts)
export REG_USER=''
export REG_TOKEN=''

# 3. Your Git repository URL — what the pipeline clones.
export UPGRADE_DELTA_REPO_URL='https://github.com/anurag-saran/upgrade-delta'

# Fixed — where the remediated jars live; no need to change.
export RHLN_REPO='https://packages.redhat.com/lightwell/java/remediated'
